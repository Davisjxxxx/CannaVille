{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cannaville.invalid/schema/scenario-v1.json",
  "title": "CannaVille V2 simulation scenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenario_id", "simulation_version", "fixed_timestep_seconds", "rooms", "plants"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "scenario_id": {"type": "string", "minLength": 1},
    "simulation_version": {"type": "string", "minLength": 1},
    "fixed_timestep_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 86400},
    "rooms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
          "required": ["id", "width_m", "depth_m", "cell_size_m"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "width_m": {"type": "number", "exclusiveMinimum": 0},
            "depth_m": {"type": "number", "exclusiveMinimum": 0},
          "cell_size_m": {"type": "number", "exclusiveMinimum": 0},
          "cells": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "center_x_m", "center_y_m", "environment", "lighting_schedule"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "center_x_m": {"type": "number", "minimum": 0},
                "center_y_m": {"type": "number", "minimum": 0},
                "environment": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["air_temperature_c", "relative_humidity_percent", "atmospheric_pressure_kpa", "co2_umol_per_mol"],
                  "properties": {
                    "air_temperature_c": {"type": "number"},
                    "relative_humidity_percent": {"type": "number", "minimum": 0, "maximum": 100},
                    "atmospheric_pressure_kpa": {"type": "number", "exclusiveMinimum": 0},
                    "co2_umol_per_mol": {"type": "number", "minimum": 0},
                    "leaf_temperature_c": {"type": ["number", "null"]},
                    "airflow_m_per_s": {"type": ["number", "null"], "minimum": 0},
                    "incident_shortwave_w_m2": {"type": ["number", "null"], "minimum": 0},
                    "radiative_surroundings_temperature_c": {"type": ["number", "null"]}
                  }
                },
                "lighting_schedule": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["start_seconds", "end_seconds", "ppfd_umol_per_m2_s"],
                    "properties": {
                      "start_seconds": {"type": "number", "minimum": 0, "maximum": 86400},
                      "end_seconds": {"type": "number", "minimum": 0, "maximum": 86400},
                      "ppfd_umol_per_m2_s": {"type": "number", "minimum": 0},
                      "incident_shortwave_w_m2": {"type": ["number", "null"], "minimum": 0}
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "plants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "room_id", "cultivar_id", "x_m", "y_m", "z_m"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "room_id": {"type": "string", "minLength": 1},
          "cultivar_id": {"type": "string", "minLength": 1},
          "x_m": {"type": "number", "minimum": 0},
          "y_m": {"type": "number", "minimum": 0},
          "z_m": {"type": "number", "minimum": 0},
          "gas_exchange_profile_id": {"type": "string", "minLength": 1},
          "effective_transpiring_leaf_area_m2": {"type": "number", "exclusiveMinimum": 0},
          "leaf_characteristic_dimension_m": {"type": "number", "exclusiveMinimum": 0},
          "leaf_temperature_mode": {"enum": ["EXTERNAL_LEAF_TEMPERATURE", "SOLVED_LEAF_ENERGY_BALANCE", "UNAVAILABLE"]},
          "leaf_energy_profile": {
            "type": "object",
            "additionalProperties": false,
            "required": ["profile_id", "shortwave_absorptance", "longwave_emissivity", "surface_factor", "area_basis", "solver_min_temperature_c", "solver_max_temperature_c", "air_relative_bracket_k", "temperature_tolerance_k", "residual_tolerance_w_m2", "max_iterations", "source", "evidence_classification", "calibration_status", "valid_domain"],
            "properties": {
              "profile_id": {"type": "string", "minLength": 1},
              "model_version": {"type": "string", "minLength": 1},
              "leaf_temperature_mode": {"enum": ["EXTERNAL_LEAF_TEMPERATURE", "SOLVED_LEAF_ENERGY_BALANCE", "UNAVAILABLE"]},
              "shortwave_absorptance": {"type": "number", "minimum": 0, "maximum": 1},
              "longwave_emissivity": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
              "surface_factor": {"type": "number", "exclusiveMinimum": 0},
              "area_basis": {"const": "projected_one_sided_leaf_area"},
              "solver_min_temperature_c": {"type": "number"},
              "solver_max_temperature_c": {"type": "number"},
              "air_relative_bracket_k": {"type": "number", "exclusiveMinimum": 0},
              "temperature_tolerance_k": {"type": "number", "exclusiveMinimum": 0},
              "residual_tolerance_w_m2": {"type": "number", "exclusiveMinimum": 0},
              "max_iterations": {"type": "integer", "minimum": 1},
              "source": {"type": "string", "minLength": 1},
              "evidence_classification": {"type": "string", "minLength": 1},
              "calibration_status": {"type": "string", "minLength": 1},
              "valid_domain": {"type": "string", "minLength": 1}
            }
          },
          "consequence_profile": {
            "type": "object",
            "additionalProperties": false,
            "required": ["profile_id", "stages", "water", "thermal", "radiation", "presentation", "source", "evidence_classification", "calibration_status", "valid_domain"],
            "properties": {
              "profile_id": {"type": "string", "minLength": 1},
              "model_version": {"type": "string", "minLength": 1},
              "stages": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["stage", "required_opportunity_s", "assimilation_reference_umol_m2_s"],
                  "properties": {
                    "stage": {"enum": ["seedling", "vegetative", "flowering", "harvest_ready"]},
                    "required_opportunity_s": {"type": "number", "exclusiveMinimum": 0},
                    "assimilation_reference_umol_m2_s": {"type": "number", "exclusiveMinimum": 0},
                    "minimum_elapsed_stage_s": {"type": ["number", "null"], "minimum": 0},
                    "minimum_dark_duration_s": {"type": ["number", "null"], "minimum": 0}
                  }
                }
              },
              "water": {"$ref": "#/$defs/consequenceExposureProfile"},
              "thermal": {"$ref": "#/$defs/consequenceExposureProfile"},
              "radiation": {"$ref": "#/$defs/consequenceExposureProfile"},
              "presentation": {
                "type": "object",
                "additionalProperties": false,
                "required": ["stress_onset", "recovery_onset", "damage_onset", "critical_onset", "thriving_opportunity"],
                "properties": {
                  "stress_onset": {"type": "number", "minimum": 0, "maximum": 1},
                  "recovery_onset": {"type": "number", "minimum": 0, "maximum": 1},
                  "damage_onset": {"type": "number", "minimum": 0, "maximum": 1},
                  "critical_onset": {"type": "number", "minimum": 0, "maximum": 1},
                  "thriving_opportunity": {"type": "number", "minimum": 0, "maximum": 1}
                }
              },
              "source": {"type": "string", "minLength": 1},
              "evidence_classification": {"type": "string", "minLength": 1},
              "calibration_status": {"type": "string", "minLength": 1},
              "valid_domain": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "consequenceExposureProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["onset", "full", "critical", "recovery_rate_per_s", "damage_onset", "damage_scale_s"],
      "properties": {
        "onset": {"type": "number"},
        "full": {"type": "number"},
        "critical": {"type": "number", "minimum": 0, "maximum": 1},
        "recovery_rate_per_s": {"type": "number", "minimum": 0},
        "damage_onset": {"type": "number", "minimum": 0, "maximum": 1},
        "damage_scale_s": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
